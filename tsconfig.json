{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "esnext",
    "target": "es5",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "shared/*": ["./src/shared/*"],
      "widgets/*": ["./src/widgets/*"],
      "app/*": ["./src/app/*"],
      "entities/*": ["./src/entities/*"],
      "features/*": ["./src/features/*"],
      "pages/*": ["./src/pages/*"]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  },
  "include": ["./src/**/*", "./config/jest/setupTests.ts"]
}
